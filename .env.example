# Copy this file to .env and fill in your own values. Never commit .env.

# Required: free key from https://console.groq.com/keys
GROQ_API_KEY=

# ---- Optional settings (defaults shown) ----
# Preferred model first, then fallbacks used on rate limits or model retirement
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile,llama-3.1-8b-instant
# GROQ_JUDGE_MODELS=openai/gpt-oss-20b,llama-3.1-8b-instant,openai/gpt-oss-120b
# RETRIEVAL_METHOD=hybrid             # vector | hybrid | rerank | hybrid_rerank
# TOP_K=5
# CANDIDATE_K=20
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# DATA_DIR=./data
# MAX_UPLOAD_MB=25

# Password-protect the app (recommended for a public deployment)
# APP_USERNAME=
# APP_PASSWORD=

# Optional: persist notebooks on an ephemeral host (Cloud Run) by syncing to a private Hugging Face dataset repo
# HF_DATASET_REPO=your-username/notebooklm-data
# HF_TOKEN=
